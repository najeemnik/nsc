# Public frontend configuration only. This value is a same-origin path, not a secret.
VITE_API_URL=/api

# PHP hosting environment (set securely in cPanel, not in the public web root):
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASS=<generate-and-set-outside-git>
# APP_SECRET=<at-least-32-random-bytes-set-outside-git>
# APP_ENV=production
# Keep false until Wave 2 passes deployment-specific PHP/MySQL authorization tests.
# NSC_EMPLOYEE_ACCESS_ENABLED=false
# APP_ALLOWED_ORIGINS=https://your-final-domain.example
