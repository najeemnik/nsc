{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run check:api-security && npm run check:material-accounting && npm run check:i18n && vite build",
    "build:host": "npm run build && rm -rf host_upload && mkdir -p host_upload && cp -r dist/* host_upload/ && cp -r api host_upload/",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js host_upload",
    "lint": "npm run check:api-security && npm run check:material-accounting && npm run check:i18n && tsc --noEmit",
    "verify:journal": "tsx scripts/verify-journal.ts",
    "verify:php-wasm": "bash scripts/verify-php-wasm.sh",
    "verify:access-control-integration": "php scripts/verify-access-control-integration.php",
    "check:i18n": "node scripts/check-localization.mjs",
    "check:api-security": "node scripts/check-api-security.mjs",
    "check:material-accounting": "node scripts/check-material-accounting.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
